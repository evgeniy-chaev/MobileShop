<Window x:Class="MobileShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MobileShop"
        mc:Ignorable="d"
		DataContext="{StaticResource MainViewModel}"
        Title="Mobile Shop" Height="500" Width="800">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Image Source="/Resources/Search_16xSM.png"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Width="16" Height="16" Margin="10 0 0 0"/>

            <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Grid>

        <ListBox ItemsSource="{Binding MobilePhones}" DisplayMemberPath="ProductName"
                 SelectedItem="{Binding SelectedPhone}" Grid.Row="1" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding SelectedPhone.ProductName}" Grid.ColumnSpan="2"
                       FontSize="18" HorizontalAlignment="Left"/>

            <TextBlock Text="Производитель:" Grid.Row="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Manufacturer}" Grid.Row="1" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Дисплей:" Grid.Row="2"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Display}" Grid.Row="2" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Связь:" Grid.Row="3"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Network}" Grid.Row="3" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Процессор:" Grid.Row="4"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.CPU}" Grid.Row="4" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Память (ОЗУ/ПЗУ):" Grid.Row="5"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Memory}" Grid.Row="5" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Камера:" Grid.Row="6"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Camera}" Grid.Row="6" Grid.Column="1"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Аккумулятор:" Grid.Row="7"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding SelectedPhone.Battery}" Grid.Row="7" Grid.Column="1"
                       HorizontalAlignment="Left"/>
        </Grid>
        
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Source="{Binding SelectedPhone.ImageBase64, Converter={StaticResource Base64ToBitmapImageConverter}}"
                   Grid.Row="0" Margin="5" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            
                <TextBlock Text="{Binding SelectedPhone.Price}" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="₽" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                
                <TextBlock Text="осталось: "
                       HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding SelectedPhone.Count}"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="шт."
                       HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">

            <Button Command="{Binding CreateCommand}" Content="+" ToolTip="Добавить"/>

            <Button Command="{Binding UpdateCommand}" Content="✏️" ToolTip="Изменить"
                    CommandParameter="{Binding SelectedPhone}"/>

            <Button Command="{Binding DeleteCommand}" Content="-" ToolTip="Удалить"
                    CommandParameter="{Binding SelectedPhone}"/>
        </StackPanel>
    </Grid>
</Window>
